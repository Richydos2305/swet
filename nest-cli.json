{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/swet-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/swet-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/swet-service",
  "projects": {
    "swet-common-lib": {
      "type": "library",
      "root": "libs/swet-common-lib",
      "entryFile": "index",
      "sourceRoot": "libs/swet-common-lib/src",
      "compilerOptions": {
        "tsConfigPath": "libs/swet-common-lib/tsconfig.lib.json"
      }
    },
    "swet-integration-lib": {
      "type": "library",
      "root": "libs/swet-integration-lib",
      "entryFile": "index",
      "sourceRoot": "libs/swet-integration-lib/src",
      "compilerOptions": {
        "tsConfigPath": "libs/swet-integration-lib/tsconfig.lib.json"
      }
    },
    "swet-notification-lib": {
      "type": "library",
      "root": "libs/swet-notification-lib",
      "entryFile": "index",
      "sourceRoot": "libs/swet-notification-lib/src",
      "compilerOptions": {
        "tsConfigPath": "libs/swet-notification-lib/tsconfig.lib.json"
      }
    },
    "swet-notification-service": {
      "type": "application",
      "root": "apps/swet-notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/swet-notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/swet-notification-service/tsconfig.app.json"
      }
    },
    "swet-service": {
      "type": "application",
      "root": "apps/swet-service",
      "entryFile": "main",
      "sourceRoot": "apps/swet-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/swet-service/tsconfig.app.json"
      }
    }
  }
}
